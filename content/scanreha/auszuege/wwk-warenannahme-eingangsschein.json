      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Die Bestellmenge liegt unter der Liefermenge."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Die Liefermenge liegt unter der Bestellmenge."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Anstelle des Artikels 0648 wurde der Artikel 6548 geliefert."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Es liegt ein versteckter Mangel vor."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "Die bestellten Größen wurden nicht eingehalten."
        }
