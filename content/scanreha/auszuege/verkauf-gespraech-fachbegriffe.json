    "title": "Verhalten beim Verkaufsgespräch",
    "stem_md": "Welches Verhalten beim Verkaufsgespräch ist richtig beschrieben?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Sie sollten sehr laut sprechen; dadurch werden Rückfragen des Kunden vermieden."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Sie sollten kaum sprechen, um nicht vom Kunden für aufdringlich gehalten zu werden."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Sie sollten von der Kontaktaufnahme bis zur Verabschiedung ständig reden, um den Kunden von Ihrem Fachwissen zu überzeugen."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Sie sollten möglichst leise zu sprechen beginnen, um die Aufmerksamkeit des Kunden zu wecken."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "Sie sollten die korrekten Fachbegriffe verwenden und erklären."
        }
      ],
