    "node_kind": "task",
    "parent_item_id": null,
    "title": "Nachteil von Kreditkarten",
    "stem_md": "Ihr Warenhaus bietet den Kunden die Möglichkeit, Wareneinkäufe mit Kreditkarte zu begleichen. Welchen Nachteil hat die Akzeptanz von Kreditkarten für Ihr Warenhaus?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Bei Zahlung mit Kreditkarte entstehen dem Warenhaus zusätzliche Kosten."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Kreditkartenzahlungen unter 50,00 € lohnen sich für das Warenhaus nicht."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Die bezogene Bank garantiert nur bis zu einem Betrag von 400,00 €."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Das Warenhaus erhält erst nach einem halben Jahr das Geld von der bezogenen Bank."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "Der getätigte Umsatz pro Kunde verringert sich."
        }
      ],
