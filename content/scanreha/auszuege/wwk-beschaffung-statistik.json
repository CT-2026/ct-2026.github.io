    "title": "Einkaufsplanung für Stofftiere aus einer Statistik",
    "stem_md": "Für die Einkaufsplanung von Stofftieren liegt Ihnen die Statistik vor. Welche Schlussfolgerung bezüglich der Einkaufsplanung leiten Sie daraus ab?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Sie müssen mehr Stofftiere in der gehobenen Preisgruppe einkaufen, da die Kunden vermehrt diese Preisgruppe nachfragen."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Sie können die Bestellmengen in allen Preisgruppen unverändert beibehalten, da sich keine Änderungen der Nachfrage ableiten lassen."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Sie kaufen keine Stofftiere der unteren Preisgruppe mehr ein, da hier weiterhin mit einem starken Rückgang der Nachfrage zu rechnen ist."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Sie verringern die Bestellmenge der unteren und mittleren Preisgruppe, da sich hier ein Rückgang der Nachfrage abzeichnet."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "Sie verringern in allen Preisgruppen die Bestellmenge, da sich generell ein Rückgang der Nachfrage abzeichnet."
        }
      ],
      "entries": [],
      "unit": null,
      "decimal_places": null,
      "rounding_rule": null
    },
