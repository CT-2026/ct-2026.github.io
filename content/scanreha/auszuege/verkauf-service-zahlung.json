    "title": "Zahlungsbezogene Serviceleistung",
    "stem_md": "Als Mitarbeiter/-in der Merlin GmbH bieten Sie Serviceleistungen zur Kundenbindung an. Welches ist eine zahlungsbezogene Serviceleistung?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Sie bieten einem Kunden die Möglichkeit zur Ratenzahlung an."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Die von einem Kunden gekauften Weingläser wickeln Sie zunächst einzeln in Papier ein, bevor Sie sie weiter verpacken."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Sie geben einer Kundin zwei Tagesdecken zur Auswahl mit, damit sie zuhause prüfen kann, ob die Decken zu ihrer Einrichtung passen."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Sie führen kleinere Reparaturen in Ihrer eigenen Werkstatt kostengünstig durch."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "In der Sportabteilung stellen Sie die Skibindung an den von einer Kundin gekauften Skiern ein."
        }
      ],
      "entries": [],
