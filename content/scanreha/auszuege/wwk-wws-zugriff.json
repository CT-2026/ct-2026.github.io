    "title": "Vorteil des Warenwirtschaftssystems für Mitarbeitende",
    "stem_md": "Prüfen Sie, welchen Vorteil Sie dadurch als Mitarbeiter/-in haben!",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1.",
          "text_md": "Durch den Einsatz des WWS können Sie Fehler beim Kassiervorgang ausschließen."
        },
        {
          "id": "choice-2",
          "original_label": "2.",
          "text_md": "Sie können schnell auf Informationen aus den Bereichen Einkauf, Lager und Verkauf Zugriff nehmen."
        },
        {
          "id": "choice-3",
          "original_label": "3.",
          "text_md": "Sie können sich Informationen über personenbezogene Daten der Mitarbeiter beschaffen."
        },
        {
          "id": "choice-4",
          "original_label": "4.",
          "text_md": "Durch die Vernetzung mit den Warenwirtschaftssystemen der Mitbewerber haben Sie auch Zugriff auf deren Absatzzahlen."
        },
        {
          "id": "choice-5",
          "original_label": "5.",
          "text_md": "Das WWS ermöglicht Ihnen eine automatische Überprüfung der Waren auf Mängel."
        }
      ],
