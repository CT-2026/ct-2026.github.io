    "title": "Zusatzverkauf",
    "stem_md": "Nach Ihrer Beratung kauft ein Kunde eine Outdoorjacke. Mit welcher Formulierung erreichen Sie am besten einen Zusatz-/Ergänzungsverkauf?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "„Mit diesem Spray können Sie die Jacke nach dem Waschen neu imprägnieren!“"
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "„Brauchen Sie sonst noch etwas?“"
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "„Möchten Sie vielleicht noch die passende Hose dazu?“"
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "„Was könnte ich Ihnen noch zu Ihrer Jacke anbieten?“"
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "„Im Erdgeschoss finden Sie auch noch Pflegeprodukte!“"
        }
      ],
