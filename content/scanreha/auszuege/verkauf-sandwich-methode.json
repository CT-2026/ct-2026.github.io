    "title": "Anwendung der Sandwich-Methode",
    "stem_md": "Im Rahmen des Beratungsgespräches setzen Sie auch die Sandwich-Methode ein. Mit welcher Kundenansprache wenden Sie diese richtig an?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "„Für 399,90 € erhalten Sie eine Kamera, die Ihnen sehr scharfe Bilder von ausgezeichneter Farbqualität liefert.“"
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "„Der Preis dieses Modells beträgt 399,90 € und liegt damit um fast 100,00 € unter der Preisempfehlung des Herstellers!“"
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "„Dieses Modell ist besonders preiswert. Der Preis beträgt 399,90 €!“"
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "„Dieses Modell hat einen 3-fach optischen Zoom und kostet 399,90 €. Darin sind bereits die Software sowie ein Video- und USB-Kabel enthalten!“"
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "„Dieses Modell kostet bei uns nur 399,90 €. Preiswerter bekommen Sie es woanders auch nicht!“"
        }
      ],
