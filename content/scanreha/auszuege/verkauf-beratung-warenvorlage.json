    "title": "Grundregeln beim Vorlegen der Ware",
    "stem_md": "Beim Vorlegen der Ware beachten Sie bestimmte Grundregeln. Welches Verhalten entspricht einer solchen Grundregel?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Sie legen die Ware immer unter Angabe des Preises vor."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Sie legen die Ware in der mittleren Preislage zuerst vor."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Sie legen die Ware in der niedrigsten Preislage zuerst vor."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Sie legen die Ware immer so vor, dass der Kunde das Preisschild nicht sieht."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "Sie legen die Ware in der obersten Preislage zuerst vor."
        }
      ],
