    "node_kind": "task",
    "parent_item_id": null,
    "title": "Bestellpunktverfahren",
    "stem_md": "Das Warenhaus Maxikauf GmbH arbeitet mit einem geschlossenen Warenwirtschaftssystem (WWS). Es ermöglicht bei vielen Artikeln die Bestellung nach dem Bestellpunktverfahren. Welchen Vorteil bringt diese Art der Bestellung für das Warenhaus?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Dieses System sichert einen kontinuierlichen Umsatzzuwachs."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Durch dieses System kommt es nicht mehr zu Präsenzlücken."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Dieses System kann in Zukunft problemlos für alle Artikel des Warenhauses eingesetzt werden und macht somit die Bestellabteilung überflüssig."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Durch dieses System wird bei Erreichen des Meldebestandes die Bestellung automatisch ausgelöst."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "Durch dieses System wird der günstigste Lieferer vor Ort ausgewählt, dadurch reduzieren sich die Transportkosten."
        }
      ],
