    "title": "Lagerdauer und Lagerkosten",
    "stem_md": "Der Abverkauf dieser Hemden läuft trotz aller Bemühungen sehr schleppend. Wie wirkt sich die Lagerdauer der Hemden auf andere betriebliche Größen aus?",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "Durch eine niedrige Lagerdauer erhöhen sich die Lagerkosten."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "Durch eine hohe Lagerdauer erhöhen sich die Lagerkosten."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "Durch eine hohe Lagerdauer erhöht sich die Umschlagshäufigkeit."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "Die Lagerdauer hat keinen Einfluss auf die Lagerkosten."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "Die hohe Lagerdauer erhöht automatisch den Warenumsatz."
        }
      ],
