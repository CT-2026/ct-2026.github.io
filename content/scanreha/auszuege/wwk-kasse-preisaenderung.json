  "item": {
    "id": "itm-zp18-vk-29",
    "revision": 1,
    "node_kind": "task",
    "parent_item_id": null,
    "title": "Preisänderung beim Kassieren",
    "stem_md": "Der Preis eines Artikels wird während einer Angebotswoche um 20 % reduziert. Die Preisänderung ist im Artikelstamm gespeichert. Entscheiden Sie, welche Vorgehensweise beim Kassieren korrekt ist!\n\nSie erfassen die Ware mit dem Handscanner ...",
    "response": {
      "type": "single_choice",
      "required_answers": 1,
      "choices": [
        {
          "id": "choice-1",
          "original_label": "1",
          "text_md": "... und müssen sich den Rabatt vom Kunden bestätigen lassen."
        },
        {
          "id": "choice-2",
          "original_label": "2",
          "text_md": "... und registrieren so den zu zahlenden Preis."
        },
        {
          "id": "choice-3",
          "original_label": "3",
          "text_md": "... und müssen zusätzlich eine Taste für reduzierte Ware drücken."
        },
        {
          "id": "choice-4",
          "original_label": "4",
          "text_md": "... und geben die GTIN bei reduzierter Ware zusätzlich über die Tastatur ein."
        },
        {
          "id": "choice-5",
          "original_label": "5",
          "text_md": "... und geben den reduzierten Preis zusätzlich über die Tastatur ein."
        }
      ],
